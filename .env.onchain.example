# P3.1 Base collector remains disabled and Telegram dry-run by default.
ONCHAIN_ENABLE=false
ONCHAIN_REAL_SEND=false

ONCHAIN_DATA_DIR=data/onchain
ONCHAIN_DB_FILE=onchain_flow.db
ONCHAIN_RUNTIME_STATUS_FILE=runtime_status.json
ONCHAIN_TG_PUSH_HISTORY_FILE=tg_push_history.json
ONCHAIN_TG_OUTBOX_FILE=tg_outbox.json
ONCHAIN_TG_TOPIC_ROUTES_FILE=tg_topic_routes.json
ONCHAIN_SIGNAL_EVENTS_FILE=signal_events.json
ONCHAIN_SIGNAL_EVENTS_DB_FILE=onchain_signals.db

ONCHAIN_CHAINS_FILE=config/onchain/chains.example.json
ONCHAIN_CEX_LABELS_FILE=config/onchain/cex_addresses.example.csv

ONCHAIN_BASE_ENABLE=false
ONCHAIN_BASE_CHAIN_ID=8453
ONCHAIN_BASE_HTTP_RPC_URL=
ONCHAIN_BASE_WSS_RPC_URL=
ONCHAIN_BASE_CONFIRMATION_DEPTH=20
ONCHAIN_BASE_BOOTSTRAP_LOOKBACK_BLOCKS=300
ONCHAIN_BASE_REORG_LOOKBACK_BLOCKS=64

ONCHAIN_RPC_TIMEOUT_SEC=10
ONCHAIN_RPC_RETRY=3
ONCHAIN_RPC_BACKOFF_SEC=1
ONCHAIN_RPC_MAX_BLOCK_RANGE=1000
ONCHAIN_RPC_MIN_BLOCK_RANGE=1
ONCHAIN_RPC_TOPIC_ADDRESS_BATCH=50
ONCHAIN_RPC_POLL_SEC=5
ONCHAIN_RPC_RATE_LIMIT_PER_SECOND=20
ONCHAIN_RPC_ADAPTIVE_MAX_REQUESTS=64
ONCHAIN_RPC_ADAPTIVE_MAX_DEPTH=12

# OAR-P1 bounded explicit Token queries. These do not enable the live service.
TOKEN_ACTIVITY_MAX_WINDOW_HOURS=24
TOKEN_ACTIVITY_MAX_EVENTS=5000
TOKEN_ACTIVITY_MAX_RPC_REQUESTS=256
TOKEN_ACTIVITY_ADAPTIVE_MAX_REQUESTS=128
TOKEN_ACTIVITY_MAX_UNIQUE_BLOCK_HEADERS=2000
TOKEN_ACTIVITY_TOP_N=50
TOKEN_ACTIVITY_BLOCK_SEARCH_MAX_CALLS=32

# Explicit-only Arkham label candidate discovery. Never used by watch-live.
ARKHAM_API_BASE_URL=https://api.arkm.com
ARKHAM_API_KEY=
ARKHAM_API_TIMEOUT_SEC=15
ARKHAM_API_MAX_RETRIES=1
OAR_LABEL_CANDIDATE_MAX_ADDRESSES=50
OAR_LABEL_CANDIDATES_FILE=label_candidates.json

# Optional Dune candidates. Empty key is a safe, non-blocking state.
DUNE_API_BASE_URL=https://api.dune.com/api
DUNE_API_KEY=
DUNE_API_TIMEOUT_SEC=15
DUNE_API_MAX_RETRIES=1
DUNE_API_MAX_REQUESTS=10
DUNE_API_POLL_INTERVAL_SEC=4
DUNE_API_EXECUTION_TIMEOUT_SEC=30
DUNE_API_MAX_ROWS=100
OAR_ADDRESS_INTELLIGENCE_FILE=address_intelligence.json

# OAR-P2 in-memory behavior and wallet-association analysis thresholds.
OAR_BEHAVIOR_MIN_TX=3
OAR_BEHAVIOR_DOMINANCE_MIN=0.67
OAR_BEHAVIOR_MIN_ACTIVE_BUCKETS_1H=2
OAR_BEHAVIOR_MIN_ACTIVE_BUCKETS_LONG=3
OAR_PATTERN_MIN_WALLETS=3
OAR_PATTERN_MIN_TX=3
OAR_PATTERN_MIN_AMOUNT_SHARE=0.10
OAR_WALLET_SYNC_WINDOW_SEC=300
OAR_WALLET_AMOUNT_SIMILARITY_TOLERANCE=0.10
OAR_MAX_ANALYZED_WALLETS=100
OAR_MAX_WALLET_GROUPS=20
OAR_MAX_SOURCE_EVENT_IDS=50

# OAR-P3/P5B optional OpenAI-compatible reporting. Disabled by default.
OAR_AI_ENABLE=false
OAR_AI_PROVIDER=deepseek
OAR_AI_BASE_URL=https://api.deepseek.com
OAR_AI_API_KEY=
OAR_AI_MODEL=deepseek-v4-pro
OAR_AI_THINKING_MODE=enabled
OAR_AI_REASONING_EFFORT=high
OAR_AI_MAX_TOKENS=8192
OAR_AI_OPERATOR_PROMPT_FILE=data/onchain/config/oar_ai_operator_prompt.txt
OAR_AI_TIMEOUT_SEC=60
OAR_AI_MAX_RETRIES=0
OAR_AI_MAX_CALLS_PER_HOUR=10
OAR_AI_CACHE_TTL_SEC=3600
OAR_AI_MAX_CONTEXT_CHARS=30000
OAR_AI_MAX_OUTPUT_CHARS=8000
OAR_AI_CACHE_FILE=oar_ai_cache.json
OAR_REPLACE_COMPLETE_CARD_WITH_PARTIAL=false
OAR_REPLACE_RICH_AI_CARD_WITH_RULE_ONLY=false

# OAR-P4 verified registry, read-only signal bridge, and bounded watch scans.
# Automation remains disabled until an explicit server rollout.
OAR_AUTOMATION_ENABLE=false
# OAR-P5D systemd delivery policy. Observe is the fail-safe default.
OAR_WATCH_DELIVERY_MODE=observe
OAR_WATCH_WITH_AI=false
OAR_WATCH_REAL_SEND_ACK=
OAR_AUTOMATION_DB_FILE=oar_automation.db
OAR_MAIN_SIGNAL_DB_FILE=data/signals.db
OAR_BRIDGE_ALLOWED_MODULES=launch,flow,funding,announcement
OAR_BRIDGE_OVERLAP_SEC=300
OAR_BRIDGE_BOOTSTRAP_LOOKBACK_SEC=3600
OAR_BRIDGE_MAX_SIGNALS_PER_CYCLE=100
OAR_WATCH_MAX_ACTIVE_TOKENS=50
OAR_WATCH_MAX_TOKENS_PER_CYCLE=5
# For rolling 15m queries, scan interval + live poll must not exceed 900.
# Example production overlap: 840 + 60 = 900.
OAR_WATCH_SCAN_INTERVAL_SEC=900
OAR_WATCH_LIVE_POLL_SEC=60
OAR_WATCH_QUERY_WINDOW=4h
OAR_WATCH_LEASE_SEC=600
OAR_WATCH_MAX_CONSECUTIVE_FAILURES=10
OAR_WATCH_MANUAL_TTL_SEC=2592000
OAR_WATCH_LAUNCH_TTL_SEC=86400
OAR_WATCH_FLOW_TTL_SEC=86400
OAR_WATCH_FUNDING_TTL_SEC=43200
OAR_WATCH_ANNOUNCEMENT_TTL_SEC=259200
OAR_WATCH_MANUAL_PRIORITY=100
OAR_WATCH_LAUNCH_PRIORITY=90
OAR_WATCH_FLOW_PRIORITY=80
OAR_WATCH_FUNDING_PRIORITY=70
OAR_WATCH_ANNOUNCEMENT_PRIORITY=75
OAR_WATCH_NOTIFY_MIN_BEHAVIOR_SCORE=55
OAR_WATCH_NOTIFY_MIN_WALLET_SCORE=60
OAR_WATCH_NOTIFY_PARTIAL=false
OAR_WATCH_CONTROLLED_ALERT_ENABLE=false
OAR_WATCH_MAX_EVENTS_PER_TOKEN=1000
OAR_WATCH_MAX_RPC_REQUESTS_PER_TOKEN=100
OAR_WATCH_TOP_TRANSFERS=20
OAR_WATCH_MAX_RPC_REQUESTS_PER_CYCLE=400
OAR_WATCH_BASELINE_MIN_SAMPLES=8
OAR_WATCH_BASELINE_MAX_SAMPLES=64
OAR_WATCH_BASELINE_MAD_MULTIPLIER=3.5

ONCHAIN_WSS_RECONNECT_SEC=5
ONCHAIN_WSS_IDLE_TIMEOUT_SEC=30
ONCHAIN_WSS_QUEUE_MAX=100

ONCHAIN_PRICE_ENABLE=false
ONCHAIN_PRICE_PROVIDER=none
ONCHAIN_PRICE_MAX_AGE_SEC=300
ONCHAIN_PRICE_BATCH_SIZE=50
ONCHAIN_PRICE_RATE_LIMIT_PER_MINUTE=30
ONCHAIN_COINGECKO_API_BASE_URL=https://pro-api.coingecko.com/api/v3
ONCHAIN_COINGECKO_API_KEY=

ONCHAIN_NET_DOMINANCE_MIN=0.60
ONCHAIN_ROLLING_EVALUATION_BUCKET_SEC=300

ONCHAIN_TG_HOURLY_LIMIT=6
ONCHAIN_ALERT_COOLDOWN_SEC=3600
ONCHAIN_ALERT_MAX_EVENT_AGE_SEC=1800
# OAR reuses TG_BOT_TOKEN and TG_CHAT_ID from .env.oi. Only its topic is local.
TG_ONCHAIN_FLOW_TOPIC_ID=

# Opt-in group query worker. It only accepts explicit @Bot or /oar commands
# from the configured group and the configured on-chain topic.
OAR_TELEGRAM_QUERY_ENABLE=false
OAR_TELEGRAM_QUERY_ACK=
OAR_TELEGRAM_QUERY_POLL_TIMEOUT_SEC=20
OAR_TELEGRAM_QUERY_COOLDOWN_SEC=60
OAR_TELEGRAM_QUERY_MAX_PER_HOUR=12
OAR_TELEGRAM_QUERY_MAX_EVENTS=500
OAR_TELEGRAM_QUERY_MAX_RPC_REQUESTS=128
OAR_TELEGRAM_QUERY_TOP_N=20
OAR_TELEGRAM_QUERY_STATE_FILE=telegram_query_state.json

ONCHAIN_MIN_LABEL_CONFIDENCE=0.80
ONCHAIN_SINGLE_LARGE_FLOOR_USD=1000000
ONCHAIN_BATCH_15M_FLOOR_USD=2000000
ONCHAIN_CONTINUOUS_60M_FLOOR_USD=4000000
ONCHAIN_SINGLE_VOLUME_RATIO=0.001
ONCHAIN_BATCH_VOLUME_RATIO=0.002
ONCHAIN_CONTINUOUS_VOLUME_RATIO=0.004
ONCHAIN_BASELINE_MAD_MULTIPLIER=3

# OAR-P7 deterministic single-transfer risk. Disabled by default. These
# snapshot calls share the existing bounded Token Activity RPC client.
OAR_SINGLE_TRANSFER_RISK_ENABLE=false
OAR_SINGLE_TRANSFER_MIN_SCORE=60
OAR_SINGLE_TRANSFER_CRITICAL_SCORE=80
OAR_SENDER_EXIT_HIGH=0.80
OAR_SENDER_EXIT_NEAR_FULL=0.95
OAR_SENDER_EXIT_FULL=0.99
OAR_SUPPLY_SHARE_WATCH=0.001
OAR_SUPPLY_SHARE_HIGH=0.005
OAR_SINGLE_TRANSFER_MAX_BALANCE_CALLS=20
OAR_SINGLE_TRANSFER_MAX_SUPPLY_CALLS=5
OAR_SINGLE_TRANSFER_SNAPSHOT_TTL_SEC=300

# OAR-P7 BSC generic-EVM skeleton. It remains disabled until a dedicated BSC
# endpoint is configured and a later Observe rollout explicitly enables it.
OAR_BSC_ENABLE=false
OAR_BSC_HTTP_RPC_URL=
OAR_BSC_CONFIRMATION_DEPTH=15
OAR_BSC_REORG_LOOKBACK_BLOCKS=64

# Additional EVM chains share the same Registry, Token Activity, Analysis,
# Watch, risk, and report implementation. Each chain remains disabled until
# both its enable flag and private RPC endpoint are configured.
OAR_ETHEREUM_ENABLE=false
OAR_ETHEREUM_HTTP_RPC_URL=
OAR_ARBITRUM_ENABLE=false
OAR_ARBITRUM_HTTP_RPC_URL=
OAR_OPTIMISM_ENABLE=false
OAR_OPTIMISM_HTTP_RPC_URL=
OAR_POLYGON_ENABLE=false
OAR_POLYGON_HTTP_RPC_URL=
OAR_AVALANCHE_ENABLE=false
OAR_AVALANCHE_HTTP_RPC_URL=
