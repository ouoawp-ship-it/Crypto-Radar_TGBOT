[Unit]
Description=Paopao OAR Telegram Group Query Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/paopao-crypto-radar
EnvironmentFile=/home/ubuntu/paopao-crypto-radar/.env.onchain
EnvironmentFile=-/home/ubuntu/paopao-crypto-radar/.env.oi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/paopao-crypto-radar/scripts/run_oar_query.sh
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
SuccessExitStatus=130
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
