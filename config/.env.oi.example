DIVERGENCE_RESONANCE_PRICE_MIN=3
DIVERGENCE_PRESSURE_OI_MIN=5
DIVERGENCE_PRESSURE_PRICE_MIN=1
DIVERGENCE_PRESSURE_PRICE_MAX=3
DIVERGENCE_BREAKOUT_OI_MAX=-5
DIVERGENCE_BREAKOUT_PRICE_MIN=3
TOPIC_MESSAGE_CLEANUP_MAX_AGE_SEC=169200

# Binance official announcements: independent risk radar with its own topic and push.
# Announcement results are not used by the pulse radar.
ANNOUNCEMENT_RISK_ENABLE=true
ANNOUNCEMENT_STATE_FILE=announcement_state.json
ANNOUNCEMENT_PAGE_SIZE=50
ANNOUNCEMENT_ONLY_TODAY=true
ANNOUNCEMENT_DEFAULT_TTL_DAYS=3

# Divergence state
OI_DIVERGENCE_STATE_FILE=oi_divergence_state.json
OI_DIVERGENCE_COOLDOWN_FILE=oi_divergence_cooldown.json
