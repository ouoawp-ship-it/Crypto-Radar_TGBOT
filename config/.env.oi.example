# Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=
# Telegram 私聊管理默认关闭；管理员 ID 只在 FinalShell 配置。
TG_PRIVATE_CONTROL_ENABLE=false
TG_PRIVATE_CONTROL_ADMIN_USER_ID=
# 主动故障提醒需单独开启；默认不主动发私聊。
TG_PRIVATE_CONTROL_ALERT_ENABLE=false
TG_PRIVATE_CONTROL_ALERT_COOLDOWN_SEC=3600
MAIN_BOT_DELIVERY_MODE=dry_run
MAIN_BOT_REAL_SEND=false
MAIN_BOT_REAL_SEND_ACK=
TG_TOPIC_ID=
TELEGRAM_USE_TOPIC=false
# Forum-topic routes. Each core radar requires its own configured or manually
# saved route; missing routes fail closed instead of falling back to the group.
TG_RADAR_SUMMARY_TOPIC_ID=
TG_LAUNCH_ALERT_TOPIC_ID=
TG_ANNOUNCEMENT_ALERT_TOPIC_ID=
TG_TEST_TOPIC_ID=
TG_FLOW_RADAR_TOPIC_ID=
TG_FUNDING_ALERT_TOPIC_ID=
# 盘整突破雷达专属话题；也可用 telegram-topic-setup 显式创建并保存路由。
TG_CONSOLIDATION_BREAKOUT_TOPIC_ID=
# 人工预建“山寨合约异动”话题的数字 ID；不会自动创建，也不回退主群。
TG_ALTCOIN_CONTRACT_ANOMALY_TOPIC_ID=
# Normal delivery never creates topics or publishes topic introductions.
# Use the explicit telegram-topic-setup operation for those network actions.
TG_TOPIC_ROUTES_FILE=tg_topic_routes.json
TG_TOPIC_INTRO_PIN=true

# BOT signal and context stores
SIGNAL_EVENTS_DB_FILE=signals.db
SIGNAL_EVENTS_LIMIT=20000
SIGNAL_EVENTS_RETENTION_DAYS=365
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION_DAYS=7
MARKET_SNAPSHOTS_DB_FILE=market_snapshots.db
MARKET_SNAPSHOT_INTERVAL_SEC=300
MARKET_SNAPSHOT_RETENTION_DAYS=7
MARKET_SNAPSHOT_LIMIT=160
MARKET_SNAPSHOT_OI_LIMIT=80
MARKET_SNAPSHOT_WORKERS=8
MARKET_FLOW_FACT_INTERVAL_SEC=900
MARKET_FLOW_FACT_LIMIT=40
MARKET_READINESS_TARGET_DAYS=7
REALTIME_FEATURES_DB_FILE=realtime_features.db
BINANCE_COORDINATION_DB_FILE=binance_coordination.db
REALTIME_MARKET_BUCKET_SEC=60
REALTIME_MARKET_GRACE_MS=2000
REALTIME_MARKET_FLUSH_INTERVAL_SEC=1
REALTIME_MARKET_RECONNECT_SEC=5
REALTIME_MARKET_CONNECT_TIMEOUT_SEC=15
REALTIME_MARKET_IDLE_TIMEOUT_SEC=30
REALTIME_MARKET_RETENTION_DAYS=3
REALTIME_MARKET_SYMBOL_LIMIT=80
REALTIME_MARKET_MIN_QUOTE_VOLUME=5000000
REALTIME_MARKET_SYMBOL_REFRESH_SEC=300

# HTTP / data source
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market/ws
BINANCE_API_TIMEOUT_SEC=10
BINANCE_API_RETRY=2
BINANCE_API_BACKOFF_SEC=0.8
DATA_SOURCE_CACHE_ENABLE=true
DATA_SOURCE_CACHE_TTL_SEC=10
DATA_SOURCE_CACHE_MAX_ENTRIES=128
BINANCE_SHARED_CACHE_ENABLE=true
BINANCE_GLOBAL_RATE_LIMIT_ENABLE=true
BINANCE_FUTURES_WEIGHT_PER_MINUTE=1200
BINANCE_SPOT_WEIGHT_PER_MINUTE=3000
BINANCE_FUTURES_DATA_REQUESTS_PER_5M=800
BINANCE_GLOBAL_RATE_LIMIT_MAX_WAIT_SEC=6
DATA_SOURCE_FUSE_SECONDS=900
EXCLUDED_BASE_ASSETS=XAU,XAG

# 山寨合约异动雷达 P1：仅提供一次性候选池扫描，默认关闭且不发送 Telegram。
ALTCOIN_CONTRACT_ANOMALY_ENABLE=false
ALTCOIN_CONTRACT_ANOMALY_CMC_API_KEY=
ALTCOIN_CONTRACT_ANOMALY_CMC_CONNECT_TIMEOUT_SEC=5
ALTCOIN_CONTRACT_ANOMALY_CMC_READ_TIMEOUT_SEC=15
ALTCOIN_CONTRACT_ANOMALY_CMC_RETRY=2
ALTCOIN_CONTRACT_ANOMALY_CMC_BACKOFF_BASE_SEC=0.5
ALTCOIN_CONTRACT_ANOMALY_CMC_MIN_REQUEST_INTERVAL_SEC=2.0
ALTCOIN_CONTRACT_ANOMALY_CMC_BATCH_SIZE=100
ALTCOIN_CONTRACT_ANOMALY_CMC_CACHE_TTL_SEC=300
ALTCOIN_CONTRACT_ANOMALY_CMC_MAX_DATA_AGE_SEC=900
ALTCOIN_CONTRACT_ANOMALY_CMC_CACHE_FILE=altcoin_contract_anomaly_cmc_cache.json
ALTCOIN_CONTRACT_ANOMALY_CANDIDATE_SNAPSHOT_FILE=altcoin_contract_anomaly_candidate_pool.json
ALTCOIN_CONTRACT_ANOMALY_MAPPING_OVERRIDES_FILE=config/altcoin_contract_anomaly_overrides.json
ALTCOIN_CONTRACT_ANOMALY_MARKET_CAP_MAX_USD=30000000
ALTCOIN_CONTRACT_ANOMALY_SHORT_SQUEEZE_MIN_OI_MARKET_CAP_RATIO=0.20
ALTCOIN_CONTRACT_ANOMALY_SHORT_SQUEEZE_MAX_FUNDING_RATE=0
ALTCOIN_CONTRACT_ANOMALY_HIGH_LEVERAGE_MIN_OI_MARKET_CAP_RATIO=0.50
ALTCOIN_CONTRACT_ANOMALY_CANDIDATE_REFRESH_SEC=300
ALTCOIN_CONTRACT_ANOMALY_BINANCE_OI_MAX_AGE_SEC=600
ALTCOIN_CONTRACT_ANOMALY_FUNDING_MAX_AGE_SEC=600
ALTCOIN_CONTRACT_ANOMALY_TELEGRAM_PREVIEW_PAGE_CHARS=3800
ALTCOIN_CONTRACT_ANOMALY_OI_WORKERS=8
ALTCOIN_CONTRACT_ANOMALY_OI_REQUEST_BUDGET=600

# 山寨合约异动雷达 P2：仅限受限时长 Dry-run，需同时开启上面的总开关。
# P2 不发送 Telegram、不注册 systemd、不启用 CoinGlass，也不创建第二条全市场 WebSocket。
ALTCOIN_CONTRACT_ANOMALY_REALTIME_ENABLE=false
ALTCOIN_CONTRACT_ANOMALY_MANIFEST_POLL_SEC=5
ALTCOIN_CONTRACT_ANOMALY_MANIFEST_MAX_AGE_SEC=1200
ALTCOIN_CONTRACT_ANOMALY_SUBSCRIPTION_BATCH_SIZE=50
ALTCOIN_CONTRACT_ANOMALY_SUBSCRIPTION_MIN_INTERVAL_SEC=1.0
ALTCOIN_CONTRACT_ANOMALY_SUBSCRIPTION_ACK_TIMEOUT_SEC=10
ALTCOIN_CONTRACT_ANOMALY_MAX_STREAMS=300
ALTCOIN_CONTRACT_ANOMALY_REALTIME_DATA_MAX_AGE_SEC=120
# P2.2 资金费率相邻 tick 最大允许间隔，合法范围 1～30 秒；默认 15 秒。
ALTCOIN_CONTRACT_ANOMALY_FUNDING_MAX_GAP_SEC=15
# P2.1 仅支持每个新闭合 5 分钟边界刷新；必须保持 300。
ALTCOIN_CONTRACT_ANOMALY_OI_REFRESH_SEC=300
ALTCOIN_CONTRACT_ANOMALY_REALTIME_OI_MAX_AGE_SEC=600
ALTCOIN_CONTRACT_ANOMALY_REALTIME_OI_WORKERS=4
ALTCOIN_CONTRACT_ANOMALY_REALTIME_OI_REQUEST_BUDGET=50
ALTCOIN_CONTRACT_ANOMALY_FEATURE_1M_WINDOW_SEC=60
ALTCOIN_CONTRACT_ANOMALY_FEATURE_5M_WINDOW_SEC=300
# P2影子初值：5桶/4样本/80%覆盖可在12到15分钟冷启动Smoke内形成完整基线，尚未经回测校准。
ALTCOIN_CONTRACT_ANOMALY_VOLUME_BASELINE_BUCKETS=5
ALTCOIN_CONTRACT_ANOMALY_VOLUME_MIN_SAMPLES=4
ALTCOIN_CONTRACT_ANOMALY_VOLUME_MIN_COVERAGE=0.8
ALTCOIN_CONTRACT_ANOMALY_PRICE_1M_MOVE_RATIO=0.01
ALTCOIN_CONTRACT_ANOMALY_PRICE_5M_MOVE_RATIO=0.02
ALTCOIN_CONTRACT_ANOMALY_VOLUME_EXPANSION_RATIO=2.0
ALTCOIN_CONTRACT_ANOMALY_AGGRESSIVE_BUY_RATIO=0.60
ALTCOIN_CONTRACT_ANOMALY_AGGRESSIVE_SELL_RATIO=0.40
ALTCOIN_CONTRACT_ANOMALY_OPEN_INTEREST_MOVE_RATIO=0.03
ALTCOIN_CONTRACT_ANOMALY_FUNDING_POSITIVE_RATE=0.0005
ALTCOIN_CONTRACT_ANOMALY_FUNDING_CHANGE_RATIO=0.0001
ALTCOIN_CONTRACT_ANOMALY_LIQUIDATION_MIN_USD=100000
ALTCOIN_CONTRACT_ANOMALY_PRICE_STALL_RATIO=0.003
ALTCOIN_CONTRACT_ANOMALY_WEAKENING_VOLUME_RATIO=1.2
ALTCOIN_CONTRACT_ANOMALY_WEAKENING_WINDOWS=2
ALTCOIN_CONTRACT_ANOMALY_REALTIME_STATE_FILE=altcoin_contract_anomaly_p2_state.json
ALTCOIN_CONTRACT_ANOMALY_REALTIME_EVENT_FILE=altcoin_contract_anomaly_p2_events.jsonl
ALTCOIN_CONTRACT_ANOMALY_SMOKE_DURATION_SEC=900

# 山寨合约异动 Final 生产模式：默认关闭；普通 market-stream 还需显式
# --altcoin-production 才会注入 Controller。真实发送另需双 CLI 门禁。
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_ENABLE=false
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_SEND_ENABLE=false
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_SEND_CONFIRM=
# 全量候选扫描约使用 347 次 Binance OI 请求；默认每 30 分钟单飞刷新，
# 40 分钟硬过期，失败期间保留上一份有效订阅但停止过期信号。
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_MANIFEST_REFRESH_SEC=1800
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_MANIFEST_RETRY_SEC=60
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_MANIFEST_MAX_AGE_SEC=2400
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_COOLDOWN_SEC=3600
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_HOURLY_LIMIT=20
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_DAILY_LIMIT=50
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_QUEUE_SIZE=256
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_STATUS_INTERVAL_SEC=30
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_OI_BUDGET_WINDOW_SEC=300
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_OBSERVATION_STATE_FILE=altcoin_contract_anomaly_production_observation_state.json
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_OBSERVATION_EVENT_FILE=altcoin_contract_anomaly_production_observation_events.jsonl
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_STATE_FILE=altcoin_contract_anomaly_production_state.json
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_OUTBOX_FILE=altcoin_contract_anomaly_production_outbox.json
ALTCOIN_CONTRACT_ANOMALY_PRODUCTION_STATUS_FILE=altcoin_contract_anomaly_production_status.json
ALTCOIN_CONTRACT_ANOMALY_REALTIME_LOCK_FILE=altcoin_contract_anomaly_realtime.lock

# Request budgets
OI_HIST_REQUEST_BUDGET=80
KLINE_REQUEST_BUDGET=120
FUNDING_HISTORY_REQUEST_BUDGET=25

# Telegram safety
TG_PUSH_HISTORY_FILE=tg_push_history.json
TG_OUTBOX_FILE=tg_outbox.json
TG_OUTBOX_QUARANTINE_SEC=900
TG_OUTBOX_RETENTION_DAYS=7
RUNTIME_STATUS_FILE=runtime_status.json
TG_PUSH_SPLIT_LIMIT=3800
TG_PUSH_TIMEOUT_SEC=10
TG_PUSH_RETRY=2
TG_GLOBAL_HOURLY_LIMIT=20
TG_DEFAULT_COOLDOWN_SEC=21600
TG_PUSH_HISTORY_LIMIT=2000
TG_PUSH_HISTORY_RETENTION_DAYS=30

# Runtime cleanup
CLEANUP_ENABLE=true
CLEANUP_INTERVAL_SEC=3600
CLEANUP_STATE_FILE=cleanup_state.json
CLEANUP_CORRUPT_RETENTION_DAYS=7
CLEANUP_LOG_RETENTION_DAYS=14

# Runtime health gate
HEALTH_RUNTIME_MAX_AGE_SEC=600
HEALTH_REALTIME_FRESH_SEC=180
HEALTH_DATABASE_BACKUP_MAX_AGE_SEC=129600
HEALTH_DISK_WARN_MB=1024
HEALTH_DISK_FAIL_MB=256

# Money radar
# 0 means disabled in the new safe runner.
RADAR_SUMMARY_ENABLE=true
RADAR_SCAN_LIMIT=120
RADAR_MIN_QUOTE_VOLUME=5000000
RADAR_TOP_N=8
RADAR_SUMMARY_MIN_INTERVAL_SEC=21600
RADAR_SUMMARY_CLOSE_DELAY_SEC=300
RADAR_SUMMARY_MAX_DAILY_PUSH=4
RADAR_STATE_FILE=radar_state.json
FUNDING_SNAPSHOT_FILE=funding_snapshot.json
# 收筹质量：资金摘要内部诊断，不参与脉冲雷达触发。
# 横盘基线45天，另加近期7天；默认至少需要52根完整日线。
ACCUMULATION_MIN_HISTORY_DAYS=45
ACCUMULATION_MAX_RANGE_PCT=80
ACCUMULATION_MAX_ABS_SLOPE_PCT=20
ACCUMULATION_MAX_AVG_DAILY_QUOTE_VOLUME=20000000
ACCUMULATION_RECENT_DAYS=7
ACCUMULATION_MAX_RECENT_PRICE_GAIN_PCT=300
# Five-factor flow radar
FLOW_RADAR_ENABLE=true
FLOW_SCAN_LIMIT=24
FLOW_FIXED_TOP=10
FLOW_TICKER_FILTER_PCT=2
FLOW_FUNDING_FILTER_PCT=0.05
FLOW_CANDIDATE_STATE_FILE=flow_candidate_state.json
# P1.1 默认最多展示 8 条；旧值 5 会在部署同步时迁移，其他自定义值保留。
FLOW_TOP_N=8
# 兼容旧环境保留；P1.1 已取消 60-100 分评分，不再读取此值过滤。
FLOW_MIN_SCORE=60
FLOW_INTERVAL_SEC=3600
FLOW_CLOSE_DELAY_SEC=300
FLOW_SPOT_NET_RATIO_MIN_PCT=3
FLOW_FUTURES_NET_RATIO_MIN_PCT=2
FLOW_SPOT_NET_MIN_USD=10000
FLOW_FUTURES_NET_MIN_USD=25000
FLOW_PRICE_MOVE_MIN_PCT=1
FLOW_PRICE_FLAT_MAX_PCT=1.5
FLOW_OI_BUILD_MIN_PCT=2
FLOW_OI_UNWIND_MAX_PCT=-1.5

# Multi-timeframe consolidation breakout radar. Full active USDT-perpetual
# universe rotates in budget-safe batches; 0 quote-volume floor excludes none.
# Disabled by default so a new installation remains opt-in.
CONSOLIDATION_BREAKOUT_ENABLE=false
CONSOLIDATION_BREAKOUT_INTERVAL_SEC=300
CONSOLIDATION_BREAKOUT_CLOSE_DELAY_SEC=90
CONSOLIDATION_BREAKOUT_SCAN_LIMIT=40
CONSOLIDATION_BREAKOUT_MIN_QUOTE_VOLUME=0
# Legacy 4h + 1d + 1w keeps fixed 24/72/240-bar ranges unchanged.
# The independent adaptive 1D product below tests 20-500 day anchors and keeps
# 620 closed daily bars so a 500-day structure retains stability/ATR context.
CONSOLIDATION_BREAKOUT_TIMEFRAMES=4h,1d,1w
CONSOLIDATION_BREAKOUT_STRONG_VOLUME_RATIO=1.20
CONSOLIDATION_BREAKOUT_REQUIRE_STRONG_VOLUME=false
# Closed-bar three-push price/MACD divergence; separately opt in after rollout.
CONSOLIDATION_BREAKOUT_THREE_PUSH_ENABLE=false
CONSOLIDATION_BREAKOUT_MAX_SIGNALS_PER_SCAN=8
CONSOLIDATION_BREAKOUT_STATE_FILE=consolidation_breakout_state.json
# Adaptive 1D product. It is independently disabled and remains shadow-only
# until detection quality and one complete target-daily-close market round are
# accepted. The digest is emitted after coverage, never at a fixed 08:00 CST.
CONSOLIDATION_DAILY_PRODUCT_ENABLE=false
CONSOLIDATION_DAILY_SHADOW_MODE=true
CONSOLIDATION_DAILY_DIGEST_ENABLE=false
CONSOLIDATION_DAILY_BOUNDARY_EVENTS_ENABLE=false
CONSOLIDATION_DAILY_HISTORY_BARS=620
CONSOLIDATION_DAILY_DIGEST_MAX_ITEMS=20
CONSOLIDATION_DAILY_RETRY_ROUNDS=2
CONSOLIDATION_DAILY_MAX_WAIT_SEC=10800
CONSOLIDATION_DAILY_STATE_FILE=consolidation_daily_product_state.json
CONSOLIDATION_DAILY_DIGEST_STATE_FILE=consolidation_daily_digest_state.json
# Funding-rate alert radar
FUNDING_ALERT_ENABLE=true
FUNDING_ALERT_INTERVAL_SEC=180
FUNDING_ALERT_SCAN_LIMIT=120
FUNDING_SCAN_CONCURRENCY=8
FUNDING_REQUEST_TIMEOUT_SEC=8
FUNDING_MAX_SYMBOLS_PER_BATCH=120
FUNDING_ALERT_MIN_QUOTE_VOLUME=5000000
FUNDING_ALERT_EXCHANGES=BINANCE
FUNDING_ALERT_HISTORY_LIMIT=4
FUNDING_ALERT_COOLDOWN_SEC=3600
FUNDING_ALERT_EXTREME_NEGATIVE_PCT=-0.5
FUNDING_ALERT_SUPER_NEGATIVE_PCT=-1.0
FUNDING_ALERT_EXTREME_POSITIVE_PCT=0.5
FUNDING_ALERT_MIN_EXCHANGE_COUNT=1
FUNDING_ALERT_DIVERGENCE_PCT=0.75
FUNDING_ALERT_DECAY_QUIET_SCANS=2
FUNDING_ALERT_END_QUIET_SCANS=5
FUNDING_ALERT_STATE_FILE=funding_alert_state.json
# 费率由非负刚转负且四段 1h OI 连续增长的独立事件；默认关闭。
FUNDING_FLIP_OI_ENABLE=false
FUNDING_FLIP_OI_STATE_FILE=funding_flip_oi_state.json
FUNDING_FLIP_OI_WINDOW_POINTS=48
FUNDING_FLIP_OI_MIN_COVERAGE=0.90
FUNDING_FLIP_OI_MAX_AGE_SEC=10800
FUNDING_FLIP_OI_MIN_GROWTH_PCT=8
FUNDING_FLIP_OI_SEGMENT_TOLERANCE_PCT=0.5
FUNDING_FLIP_OI_RATE_MAX_AGE_SEC=900
FUNDING_FLIP_OI_COOLDOWN_SEC=86400

# Pulse radar: directly replaces the removed launch-warning implementation.
# The 15m alert and 2h divergence card share TG_LAUNCH_ALERT_TOPIC_ID.
PULSE_RADAR_ENABLE=true
SIMPLE_ALERT_SCAN_LIMIT=0
SIMPLE_ALERT_FIXED_TOP=30
SIMPLE_ALERT_ROTATION_SLOTS=10
