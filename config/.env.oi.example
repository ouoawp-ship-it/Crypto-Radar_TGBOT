# Telegram
TG_BOT_TOKEN=
# 机器人公开用户名，不带 @；仅用于生成“AI解读”私聊按钮，不是密钥。
TG_BOT_USERNAME=
TG_CHAT_ID=
# Telegram 私聊管理默认关闭；管理员 ID 只在 FinalShell 配置。
TG_PRIVATE_CONTROL_ENABLE=false
TG_PRIVATE_CONTROL_ADMIN_USER_ID=
# 主动故障提醒需单独开启；默认不主动发私聊。
TG_PRIVATE_CONTROL_ALERT_ENABLE=false
TG_PRIVATE_CONTROL_ALERT_COOLDOWN_SEC=3600
MAIN_BOT_DELIVERY_MODE=dry_run
MAIN_BOT_REAL_SEND=false
MAIN_BOT_REAL_SEND_ACK=
TG_TOPIC_ID=
TELEGRAM_USE_TOPIC=false
# Forum-topic routes. Each core radar requires its own configured or manually
# saved route; missing routes fail closed instead of falling back to the group.
TG_RADAR_SUMMARY_TOPIC_ID=
TG_LAUNCH_ALERT_TOPIC_ID=
TG_ANNOUNCEMENT_ALERT_TOPIC_ID=
TG_TEST_TOPIC_ID=
TG_FLOW_RADAR_TOPIC_ID=
TG_FUNDING_ALERT_TOPIC_ID=
# Normal delivery never creates topics or publishes topic introductions.
# Use the explicit telegram-topic-setup operation for those network actions.
TG_TOPIC_ROUTES_FILE=tg_topic_routes.json
TG_TOPIC_INTRO_PIN=true

# BOT signal and context stores
SIGNAL_EVENTS_DB_FILE=signals.db
SIGNAL_EVENTS_LIMIT=20000
SIGNAL_EVENTS_RETENTION_DAYS=365
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION_DAYS=7
MARKET_SNAPSHOTS_DB_FILE=market_snapshots.db
MARKET_SNAPSHOT_INTERVAL_SEC=300
MARKET_SNAPSHOT_RETENTION_DAYS=7
MARKET_SNAPSHOT_LIMIT=160
MARKET_SNAPSHOT_OI_LIMIT=80
MARKET_SNAPSHOT_WORKERS=8
MARKET_FLOW_FACT_INTERVAL_SEC=900
MARKET_FLOW_FACT_LIMIT=40
MARKET_READINESS_TARGET_DAYS=7
REALTIME_FEATURES_DB_FILE=realtime_features.db
REALTIME_MARKET_BUCKET_SEC=60
REALTIME_MARKET_GRACE_MS=2000
REALTIME_MARKET_FLUSH_INTERVAL_SEC=1
REALTIME_MARKET_RECONNECT_SEC=5
REALTIME_MARKET_CONNECT_TIMEOUT_SEC=15
REALTIME_MARKET_IDLE_TIMEOUT_SEC=30
REALTIME_MARKET_RETENTION_DAYS=3
REALTIME_MARKET_SYMBOL_LIMIT=80
REALTIME_MARKET_MIN_QUOTE_VOLUME=5000000
REALTIME_MARKET_SYMBOL_REFRESH_SEC=300

# HTTP / data source
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market/ws
BINANCE_API_TIMEOUT_SEC=10
BINANCE_API_RETRY=2
BINANCE_API_BACKOFF_SEC=0.8
DATA_SOURCE_CACHE_ENABLE=true
DATA_SOURCE_CACHE_TTL_SEC=10
DATA_SOURCE_CACHE_MAX_ENTRIES=128
DATA_SOURCE_FUSE_SECONDS=900
EXCLUDED_BASE_ASSETS=XAU,XAG

# 山寨合约异动雷达 P1：仅提供一次性候选池扫描，默认关闭且不发送 Telegram。
ALTCOIN_CONTRACT_ANOMALY_ENABLE=false
ALTCOIN_CONTRACT_ANOMALY_CMC_API_KEY=
ALTCOIN_CONTRACT_ANOMALY_CMC_CONNECT_TIMEOUT_SEC=5
ALTCOIN_CONTRACT_ANOMALY_CMC_READ_TIMEOUT_SEC=15
ALTCOIN_CONTRACT_ANOMALY_CMC_RETRY=2
ALTCOIN_CONTRACT_ANOMALY_CMC_BACKOFF_BASE_SEC=0.5
ALTCOIN_CONTRACT_ANOMALY_CMC_MIN_REQUEST_INTERVAL_SEC=2.0
ALTCOIN_CONTRACT_ANOMALY_CMC_BATCH_SIZE=100
ALTCOIN_CONTRACT_ANOMALY_CMC_CACHE_TTL_SEC=300
ALTCOIN_CONTRACT_ANOMALY_CMC_MAX_DATA_AGE_SEC=900
ALTCOIN_CONTRACT_ANOMALY_CMC_CACHE_FILE=altcoin_contract_anomaly_cmc_cache.json
ALTCOIN_CONTRACT_ANOMALY_CANDIDATE_SNAPSHOT_FILE=altcoin_contract_anomaly_candidate_pool.json
ALTCOIN_CONTRACT_ANOMALY_MAPPING_OVERRIDES_FILE=config/altcoin_contract_anomaly_overrides.json
ALTCOIN_CONTRACT_ANOMALY_MARKET_CAP_MAX_USD=30000000
ALTCOIN_CONTRACT_ANOMALY_SHORT_SQUEEZE_MIN_OI_MARKET_CAP_RATIO=0.20
ALTCOIN_CONTRACT_ANOMALY_SHORT_SQUEEZE_MAX_FUNDING_RATE=0
ALTCOIN_CONTRACT_ANOMALY_HIGH_LEVERAGE_MIN_OI_MARKET_CAP_RATIO=0.50
ALTCOIN_CONTRACT_ANOMALY_CANDIDATE_REFRESH_SEC=300
ALTCOIN_CONTRACT_ANOMALY_BINANCE_OI_MAX_AGE_SEC=600
ALTCOIN_CONTRACT_ANOMALY_FUNDING_MAX_AGE_SEC=600
ALTCOIN_CONTRACT_ANOMALY_TELEGRAM_PREVIEW_PAGE_CHARS=3800
ALTCOIN_CONTRACT_ANOMALY_OI_WORKERS=8
ALTCOIN_CONTRACT_ANOMALY_OI_REQUEST_BUDGET=600

# Request budgets
OI_HIST_REQUEST_BUDGET=80
KLINE_REQUEST_BUDGET=120
FUNDING_HISTORY_REQUEST_BUDGET=25

# Telegram safety
TG_PUSH_HISTORY_FILE=tg_push_history.json
TG_OUTBOX_FILE=tg_outbox.json
TG_OUTBOX_QUARANTINE_SEC=900
TG_OUTBOX_RETENTION_DAYS=7
RUNTIME_STATUS_FILE=runtime_status.json
TG_PUSH_SPLIT_LIMIT=3800
TG_PUSH_TIMEOUT_SEC=10
TG_PUSH_RETRY=2
TG_GLOBAL_HOURLY_LIMIT=20
TG_DEFAULT_COOLDOWN_SEC=21600
TG_PUSH_HISTORY_LIMIT=2000
TG_PUSH_HISTORY_RETENTION_DAYS=30

# Runtime cleanup
CLEANUP_ENABLE=true
CLEANUP_INTERVAL_SEC=3600
CLEANUP_STATE_FILE=cleanup_state.json
CLEANUP_CORRUPT_RETENTION_DAYS=7
CLEANUP_LOG_RETENTION_DAYS=14

# Runtime health gate
HEALTH_RUNTIME_MAX_AGE_SEC=600
HEALTH_REALTIME_FRESH_SEC=180
HEALTH_DATABASE_BACKUP_MAX_AGE_SEC=129600
HEALTH_DISK_WARN_MB=1024
HEALTH_DISK_FAIL_MB=256

# Money radar
# 0 means disabled in the new safe runner.
RADAR_SUMMARY_ENABLE=true
RADAR_SCAN_LIMIT=120
RADAR_MIN_QUOTE_VOLUME=5000000
RADAR_TOP_N=8
RADAR_SUMMARY_MIN_INTERVAL_SEC=21600
RADAR_SUMMARY_CLOSE_DELAY_SEC=300
RADAR_SUMMARY_MAX_DAILY_PUSH=4
RADAR_STATE_FILE=radar_state.json
FUNDING_SNAPSHOT_FILE=funding_snapshot.json
# 收筹质量：只作为启动预警辅助证据，不参与打分或触发。
# 横盘基线45天，另加近期7天；默认至少需要52根完整日线。
ACCUMULATION_MIN_HISTORY_DAYS=45
ACCUMULATION_MAX_RANGE_PCT=80
ACCUMULATION_MAX_ABS_SLOPE_PCT=20
ACCUMULATION_MAX_AVG_DAILY_QUOTE_VOLUME=20000000
ACCUMULATION_RECENT_DAYS=7
ACCUMULATION_MAX_RECENT_PRICE_GAIN_PCT=300
# Five-factor flow radar
FLOW_RADAR_ENABLE=true
FLOW_SCAN_LIMIT=24
FLOW_CANDIDATE_STATE_FILE=flow_candidate_state.json
FLOW_TOP_N=5
FLOW_MIN_SCORE=60
FLOW_INTERVAL_SEC=3600
FLOW_CLOSE_DELAY_SEC=300
FLOW_SPOT_NET_RATIO_MIN_PCT=3
FLOW_FUTURES_NET_RATIO_MIN_PCT=2
FLOW_SPOT_NET_MIN_USD=10000
FLOW_FUTURES_NET_MIN_USD=25000
FLOW_PRICE_MOVE_MIN_PCT=1
FLOW_PRICE_FLAT_MAX_PCT=1.5
FLOW_OI_BUILD_MIN_PCT=2
FLOW_OI_UNWIND_MAX_PCT=-1.5
# Funding-rate alert radar
FUNDING_ALERT_ENABLE=true
FUNDING_ALERT_INTERVAL_SEC=180
FUNDING_ALERT_SCAN_LIMIT=120
FUNDING_SCAN_CONCURRENCY=8
FUNDING_REQUEST_TIMEOUT_SEC=8
FUNDING_MAX_SYMBOLS_PER_BATCH=120
FUNDING_ALERT_MIN_QUOTE_VOLUME=5000000
FUNDING_ALERT_EXCHANGES=BINANCE
FUNDING_ALERT_HISTORY_LIMIT=4
FUNDING_ALERT_COOLDOWN_SEC=3600
FUNDING_ALERT_EXTREME_NEGATIVE_PCT=-0.5
FUNDING_ALERT_SUPER_NEGATIVE_PCT=-1.0
FUNDING_ALERT_EXTREME_POSITIVE_PCT=0.5
FUNDING_ALERT_MIN_EXCHANGE_COUNT=1
FUNDING_ALERT_DIVERGENCE_PCT=0.75
FUNDING_ALERT_DECAY_QUIET_SCANS=2
FUNDING_ALERT_END_QUIET_SCANS=5
FUNDING_ALERT_STATE_FILE=funding_alert_state.json
# 费率由非负刚转负且四段 1h OI 连续增长的独立事件；默认关闭。
FUNDING_FLIP_OI_ENABLE=false
FUNDING_FLIP_OI_STATE_FILE=funding_flip_oi_state.json
FUNDING_FLIP_OI_WINDOW_POINTS=48
FUNDING_FLIP_OI_MIN_COVERAGE=0.90
FUNDING_FLIP_OI_MAX_AGE_SEC=10800
FUNDING_FLIP_OI_MIN_GROWTH_PCT=8
FUNDING_FLIP_OI_SEGMENT_TOLERANCE_PCT=0.5
FUNDING_FLIP_OI_RATE_MAX_AGE_SEC=900
FUNDING_FLIP_OI_COOLDOWN_SEC=86400

# Launch radar
# 0 means disabled in the new safe runner.
LAUNCH_ALERT_ENABLE=true
LAUNCH_SCAN_LIMIT=80
LAUNCH_FUNDING_EXCHANGES=BINANCE
LAUNCH_FUNDING_HISTORY_LIMIT=4
LAUNCH_STATE_FILE=launch_state.json
LAUNCH_WATCHLIST_FILE=launch_watchlist.json
LAUNCH_WATCH_HISTORY_FILE=launch_watch_history.json
LAUNCH_WATCH_HISTORY_LIMIT=500
LAUNCH_MIN_SCORE_PUSH=60
LAUNCH_WATCH_SCORE=45
LAUNCH_PRIMED_SCORE=60
LAUNCH_BREAKOUT_SCORE=75
LAUNCH_LAUNCHED_SCORE=90
LAUNCH_CLOSE_DELAY_SEC=60
LAUNCH_STAGE_COOLDOWN_SEC=21600
LAUNCH_INVALIDATION_GRACE_SEC=1800
# P2.1 shadow lifecycle: durable 15m observations and exact first/previous deltas.
# Keep disabled until the migration has passed production shadow acceptance.
LAUNCH_LIFECYCLE_V2_ENABLE=false
LAUNCH_LIFECYCLE_INVALID_WINDOWS=2
# P2.2 latest-message replacement. Requires LAUNCH_LIFECYCLE_V2_ENABLE=true.
LAUNCH_MESSAGE_PACKAGE_V2_ENABLE=false
# P2.5 closed-candle price action follow-up for active launch cycles.
# Requires lifecycle V2; message-package V2 is required for Telegram updates.
LAUNCH_PRICE_ACTION_V3_ENABLE=false
LAUNCH_PA_BOX_LOOKBACK=16
LAUNCH_PA_MAX_BOX_RANGE_PCT=12
LAUNCH_PA_MIN_BODY_RATIO=0.45
LAUNCH_PA_WICK_BODY_RATIO=1.5
# P2.3 in-memory PNG chart. Requires both lifecycle and message-package V2.
# When price action V3 is enabled, the chart also draws its box, frozen level,
# close-confirmation markers, and false-breakout marker.
LAUNCH_CHART_V2_ENABLE=false
# P2.4 evaluates one completed lifecycle as one sample. Historical rates stay
# hidden until the same rule set has enough completed cycles.
LAUNCH_OUTCOME_V2_ENABLE=false
LAUNCH_OUTCOME_FOLLOW_THROUGH_PCT=3.0
LAUNCH_OUTCOME_MIN_SAMPLES=20
# 新版融合信号：严格15m数据、1h独立确认、分层轮换与分组评分。
# 安全默认关闭；灰度前不会改变现有启动预警。
LAUNCH_FUSION_ENABLE=false
# 多周期看涨/看跌解读：安全默认关闭。
# 每轮最多只对6个候选进行深度多周期分析。
LAUNCH_DIRECTIONAL_ENABLE=false
LAUNCH_DIRECTIONAL_MAX_CANDIDATES=6
# AI只做白话解读；关闭AI时，确定性规则照常工作。
# 默认采用按需模式：信号下方按钮由管理员主动触发，扫描阶段不调用AI。
LAUNCH_AI_INTERPRETER_ENABLE=false
LAUNCH_AI_AUTO_ENABLE=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SEC=60
AI_ON_DEMAND_DAILY_LIMIT=20
# 同一生命周期阶段的普通变化至少间隔30分钟才更新卡片。
LAUNCH_SAME_STAGE_MIN_INTERVAL_SEC=1800
LAUNCH_PACKAGE_SCORE_DELTA=15
LAUNCH_PACKAGE_PRICE_DELTA_PCT=3.0
LAUNCH_PACKAGE_OI_DELTA_PCT=5.0
LAUNCH_MESSAGE_CLEANUP_ENABLE=false
LAUNCH_MESSAGE_CLEANUP_MAX_AGE_SEC=169200
LAUNCH_MESSAGE_CLEANUP_LIMIT=20
LAUNCH_STATE_TTL_SEC=172800
LAUNCH_FAILED_TTL_SEC=86400

# Binance official announcements: independent risk radar and launch supporting evidence.
# No standalone Telegram topic or push is created.
ANNOUNCEMENT_RISK_ENABLE=true
ANNOUNCEMENT_STATE_FILE=announcement_state.json
ANNOUNCEMENT_PAGE_SIZE=50
ANNOUNCEMENT_ONLY_TODAY=true
ANNOUNCEMENT_DEFAULT_TTL_DAYS=3

# Divergence state
OI_DIVERGENCE_STATE_FILE=oi_divergence_state.json
OI_DIVERGENCE_COOLDOWN_FILE=oi_divergence_cooldown.json
