# Independent Altcoin Hunter P1A: offline fixture/replay only.
# This file is documentation. It is not loaded on module import.
ALTCOIN_HUNTER_ENABLE=false
ALTCOIN_HUNTER_LIVE_DATA_ENABLE=false
ALTCOIN_HUNTER_SEND_ENABLE=false
ALTCOIN_HUNTER_RAW_CAPTURE_ENABLE=false
# No default production database. Supply --db with an explicit absolute path
# in an isolated temporary directory for the offline CLI. Never use legacy DBs.
ALTCOIN_HUNTER_DB_FILE=
ALTCOIN_HUNTER_BUCKET_SEC=60
ALTCOIN_HUNTER_ALLOWED_LATENESS_MS=2000
ALTCOIN_HUNTER_RETENTION_1M_DAYS=3
ALTCOIN_HUNTER_CONFIG_VERSION=1
